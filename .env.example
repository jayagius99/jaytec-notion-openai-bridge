# Required: create this in your OpenAI API account.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE

# Current GPT-5.6 Sol API model id.
OPENAI_MODEL=gpt-5.6-sol

# Required: a separate secret used only by Notion to authenticate to this MCP server.
# Generate a long random value. Do NOT reuse your OpenAI key here.
MCP_AUTH_TOKEN=PASTE_A_LONG_RANDOM_SECRET_HERE

# Hosting providers usually set PORT automatically.
PORT=8000

# Required shared OpenRouter credential for the normal free engineering/reviewer
# routes. Credential presence alone does NOT authorize paid Gemini.
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Normal/default independent research and review route.
DEEPSEEK_REVIEWER_MODEL=deepseek/deepseek-v4-flash-0731:free
DEEPSEEK_REVIEWER_TIMEOUT_S=90

# Paid terminal reserve only. JAYTEC still requires a valid PAID_BACKUP_ONLY
# TaskPacket proving free-route exhaustion, a Gemini-specific need and authority.
GEMINI_MODEL=google/gemini-3.1-pro-preview
GEMINI_TIMEOUT_S=90

# Optional GPT-5.6 Sol reserve via Vercel AI Gateway.
# SAFE DEFAULT: disabled. Do not set the attestation unless this Gateway account
# is free-credit-only and has no paid credits / automatic top-up path.
AI_GATEWAY_API_KEY=
SOL_RESERVE_ENABLED=0
SOL_FREE_CREDIT_ONLY_ATTESTED=0
SOL_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
SOL_OUTPUT_TOKEN_CAP=1800
SOL_INPUT_BYTE_CAP=64000
SOL_MIN_CREDIT_USD=0.25
SOL_REASONING_EFFORT=medium
SOL_TIMEOUT_S=60
