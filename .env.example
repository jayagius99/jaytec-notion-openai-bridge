# Required: create this in your OpenAI API account.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE

# Current GPT-5.6 Sol API model id.
OPENAI_MODEL=gpt-5.6-sol

# JAYTEC engineering specialist primary.
ENGINEERING_MODEL=gpt-5.6-sol

# Paid server-side OpenAI engineering door. Default: locked/no-spend.
# Set ACTIVE only by explicit operator decision after model-access/credit checks.
ENGINEERING_PROVIDER_MODE=LOCKED_RESERVE

# Legacy TaskPacket v1 compatibility alias. If set with ENGINEERING_MODEL,
# values MUST match or startup fails closed.
CODEX_MODEL=gpt-5.6-sol

# Shared OpenRouter credential. DeepSeek uses only its exact :free model;
# credential presence does not unlock the paid Gemini reserve.
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE

# Normal/default JAYTEC research and review route.
DEEPSEEK_PROVIDER_MODE=ACTIVE_FREE_ONLY
DEEPSEEK_REVIEWER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Exact paid Gemini reserve model. This remains unusable unless the paid reserve
# provider door is ACTIVE AND the terminal-reserve TaskPacket passes policy.
GEMINI_MODEL=google/gemini-3.1-pro-preview

# Global OpenRouter paid-reserve door. This is NOT the normal DeepSeek route.
# Gemini remains a paid last-resort backup only and additionally requires a
# valid terminal-reserve TaskPacket. Credential presence or ACTIVE mode alone
# never authorizes a Gemini call.
OPENROUTER_PROVIDER_MODE=LOCKED_RESERVE

# Required: JAYTEC control-plane bearer secret for the production execution bridge.\n# Do NOT give this token to the Notion Agent. Do NOT reuse a provider API key.\n# The production bearer secret must be 32+ non-whitespace characters with non-trivial randomness.\nMCP_AUTH_TOKEN=PASTE_A_LONG_RANDOM_SECRET_HERE\nMCP_AUTH_SUBJECT=jaytec-control-plane\nMCP_AUTH_CLIENT_ID=jaytec-control-plane\n
# JAYTEC-owned Manus runtime credential. The runtime is permanently Lite-only.
# This key is never sent in prompts or returned by tools.
MANUS_API_KEY=PASTE_YOUR_MANUS_API_KEY_HERE

# Exact MANUS project id used by JAYTEC. Project-name lookup must resolve to MANUS
# and match this id when configured.
JAYTEC_MANUS_PROJECT_ID=PASTE_MANUS_PROJECT_ID_HERE

# Hosting providers usually set PORT automatically.
PORT=8000


# Required for any real HTTP server start. Use exact public hostnames; no wildcard.
JAYTEC_MCP_ALLOWED_HOSTS_JSON=["your-jaytec-mcp.example.com"]
# Leave empty unless a browser-based MCP client is explicitly approved.
JAYTEC_MCP_ALLOWED_ORIGINS_JSON=[]
