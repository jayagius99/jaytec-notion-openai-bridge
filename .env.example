# Required: create this in your OpenAI API account.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE

# Current GPT-5.6 Sol API model id.
OPENAI_MODEL=gpt-5.6-sol

# Required: a separate secret used only by Notion to authenticate to this MCP server.
# Generate a long random value. Do NOT reuse your OpenAI key here.
MCP_AUTH_TOKEN=PASTE_A_LONG_RANDOM_SECRET_HERE

# Hosting providers usually set PORT automatically.
PORT=8000
